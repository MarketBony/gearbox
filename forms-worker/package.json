{
  "name": "gearbox-forms-worker",
  "private": true,
  "description": "Forms Bony : Worker Cloudflare public (forms.bonyauto-mobile.workers.dev). Voir README.md.",
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client.ts --bundle --minify --format=iife --target=es2019 --outfile=src/gen/client.js",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.client.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.146.0"
  }
}
