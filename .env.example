# Variables consommées par docker-compose.yml (déploiement VPS).
# Copier en .env à la racine et remplir avec les vraies valeurs — JAMAIS committées.

# Domaine public de l'app (adresse de site Caddy, HTTPS auto via Let's Encrypt).
DOMAIN=gearbox.example.com
# Email Let's Encrypt (notifications d'expiration de certificat).
ADMIN_EMAIL=admin@example.com

# Secret de signature des JWT (générer : openssl rand -hex 32).
JWT_SECRET=change-me

# Connexion applicative : pooler transaction Supabase (port 6543, ?pgbouncer=true requis par Prisma).
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations Prisma (migrate deploy) : pooler session Supabase (port 5432, sans ?pgbouncer=true).
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
