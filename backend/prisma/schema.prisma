datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Rôles/sites/marques/services = String libres alignés sur les unions de types.ts.
// Pas d'enum Prisma : "Digital Manager" contient un espace, et on ne veut aucune
// couche de traduction entre frontend et base (convention déjà en place ailleurs).
model User {
  id                String             @id @default(uuid())
  loginId           String             @unique
  passwordHash      String
  name              String
  role              String // 7 valeurs valides côté frontend (types.ts UserRole)
  avatarColor       String?
  avatarUrl         String? // URL relative de la photo de profil uploadée (/uploads/avatar/...)
  // Date de naissance au format 'YYYY-MM-DD'. String et NON DateTime, volontairement :
  // une date de naissance n'a ni heure ni fuseau, et un DateTime rouvrirait la classe
  // de bug J+1 que le projet combat déjà avec parseLocalDate. En String, la valeur
  // traverse l'API sans normalisation.
  // Vivait auparavant dans le localStorage du poste (préférence UI), ce qui la rendait
  // invisible de tous les autres — l'anniversaire est une donnée d'équipe, pas une
  // préférence. La ville, elle, reste bien en localStorage (météo de son propre poste).
  birthdate         String?
  /// Fond de discussion du Chat, choisi par l'utilisateur (11/09/2026). Deux formes, et
  /// deux seulement : `proc:<id>` pour un fond procédural du catalogue
  /// (`lib/personnalisationChat.ts`), ou `/uploads/chatbg/<uuid>.<ext>` pour une image importée.
  /// `null` = fond par défaut de l'application.
  ///
  /// ⚠️ EN BASE et non en `localStorage`, à dessein : Théo travaille sur son poste, son
  /// iPhone et son Pixel (PWA installée sur les trois). Une préférence rangée dans le
  /// navigateur serait à refaire sur chaque appareil — c'est la leçon de la date de
  /// naissance et des tags Digital, qui ont tous deux coûté un correctif.
  ///
  /// ⚠️ La valeur est VALIDÉE par le serveur (`routes/auth.ts`) : sans ça, ce champ
  /// deviendrait une seconde version du trou connu d'`avatarUrl`, où une URL externe
  /// écrite par un appel direct fait charger une ressource tierce dans le navigateur.
  chatBackground    String?
  /// Couleur des bulles de MES messages dans le Chat (11/09/2026) : un identifiant du
  /// catalogue de `lib/personnalisationChat.ts`, jamais une couleur CSS libre — accepter
  /// du CSS venu du client reviendrait a injecter une declaration de style dans la page.
  /// `null` = le degrade Bony historique.
  chatBubble        String?
  // Périmètre du rôle « Site Manager » (chef de site) : les concessions auxquelles le
  // compte est rattaché. Vide pour tous les autres rôles, qui voient l'ensemble.
  //
  // ⚠️ PREMIER champ de Gearbox qui porte un DROIT D'ACCÈS et non une préférence.
  // Il est lu côté serveur par `auth/siteScope.ts`, seule porte par laquelle un
  // périmètre s'applique — jamais recopié dans un `where` de route.
  //
  // ⚠️ Liste VIDE = ne voit RIEN (fail closed). Un chef de site sans site rattaché ne
  // doit pas hériter d'un accès complet par accident : c'est l'inverse du défaut sûr.
  sites             String[]           @default([])
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Abonnement Web Push d'un NAVIGATEUR (pas d'un utilisateur) : un même
// utilisateur en a autant qu'il a d'appareils/navigateurs installés.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Clé naturelle de l'abonnement : un navigateur qui se réabonne renvoie le
  // même endpoint. Sans @unique, chaque rechargement créerait un doublon et
  // l'utilisateur recevrait N fois la même notification.
  endpoint  String   @unique
  p256dh    String // clé publique du client (chiffrement du payload)
  auth      String // secret d'authentification du client
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id                 String        @id @default(uuid())
  name               String
  site               String
  sites              String[]      @default([])
  budgetDistribution Json? // Record<string, number> — % par site
  service            String[]
  brands             String[]
  projectType        String
  status             String
  startDate          DateTime
  endDate            DateTime
  budgetPlanned      Float
  budgetActual       Float
  description        String
  progress           Float
  assignedUsers      String[]      @default([])
  alpineShare        Float? // % Alpine vs RDM (0-100) — null = 100 % Alpine
  nissanShare        Float? // % Nissan vs RDM (0-100) — null = 100 % Nissan
  proPlus            Boolean       @default(false)
  // ⚠️⚠️ NE PAS CONFONDRE `expertMode` ET `proPlus`, qui se suivent ici et n'ont
  // AUCUN rapport :
  //  - `proPlus` = PRO+ (B2B), un marqueur MÉTIER qui pilote un filtre à trois états
  //    dans le Dashboard, le Budget et l'Export. Il change des CHIFFRES.
  //  - `expertMode` = mode Expert, un marqueur d'INTERFACE qui débloque KPI, Gantt,
  //    fichiers et notes sur ce projet. Il ne change AUCUN montant, n'entre dans
  //    aucune agrégation, et n'est lu que par l'écran Projets.
  // C'est précisément pour éviter cette collision que le mode ne s'appelle pas
  // « PRO » : « PRO » et « PRO+ » côte à côte dans le même formulaire, c'est le
  // scénario qui a laissé le bug Holding/GROUPE BONY en place des mois.
  expertMode         Boolean       @default(false)
  tasks              Task[]
  files              ProjectFile[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// Une tâche a DEUX natures depuis le 06/08/2026 :
//  - tâche de PROJET (`projectId` renseigné) : elle hérite du projet son site, ses
//    marques, son service et son échéance — d'où l'absence historique de ces champs ;
//  - tâche AUTONOME (`projectId = null`), saisie directement dans la To-do : n'ayant
//    aucun projet dont hériter, elle porte ces champs elle-même, plus une `deadline`
//    qui lui est propre. Elle n'a volontairement PAS de budget (`cost` reste à 0).
// Un seul modèle et pas deux : dupliquer aurait recréé le « second chemin, plus
// pauvre, vers un besoin déjà couvert » du correctif 10.
model Task {
  id             String        @id @default(uuid())
  // Nullable = tâche autonome. La relation devient donc optionnelle elle aussi.
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Champs propres aux tâches AUTONOMES (vides/nuls pour une tâche de projet, qui
  // continue de tout hériter de son projet).
  // ⚠️ `deadline` a cessé d'être réservée aux tâches autonomes le 26/08/2026
  // (correctif 42) : une tâche de projet porte désormais sa propre échéance.
  deadline       String? // 'yyyy-MM-dd' — String et non DateTime, comme User.birthdate
  sites          String[]      @default([])
  brands         String[]      @default([])
  service        String[]      @default([])
  // --- MODE EXPERT (27/08/2026) ---
  // Saisis dans le mode Expert d'un projet, et lus NULLE PART ailleurs : ni To-do, ni
  // Agenda, ni Campagnes, ni Export. `startDate` est ce qui permet au Gantt de tracer
  // une vraie barre — sans elle, une tâche n'a qu'un point dans le temps et se rend en
  // jalon. Même convention 'yyyy-MM-dd' que `deadline`, pour la même raison.
  startDate      String?
  notes          String?
  files          ProjectFile[]
  name           String
  provider       String? // Prestataire (texte libre)
  channel        String
  cost           Float
  status         String
  assignedUserId String? // Référence libre vers User (pas de FK, style du schéma)
  volumetry      Float?
  openRate       Float?
  npaiRate       Float?
  stopRate       Float?
  clickRate      Float?
  codTxt         String?
  billedAmount   Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // ⚠️ Index ajoute le 07/09/2026 (correctif 48). Postgres n'indexe PAS automatiquement
  // une colonne de cle etrangere : `task.findMany({ where: { projectId } })` — appele a
  // chaque PUT de projet — balayait donc la table.
  // ⚠️ HONNETEMENT : ce n'est PAS ce qui a produit les timeouts mesures. La table fait
  // quelques centaines de lignes, un balayage y coute moins d'une milliseconde ; la cause
  // etait la saturation du pooler. On l'ajoute parce que c'est gratuit, correct, et que
  // ca evite le probleme a 10 000 lignes — pas pour revendiquer un gain aujourd'hui.
  @@index([projectId])
}

// ============================================================================
// FICHIERS DE PROJET — mode Expert (27/08/2026)
// ============================================================================
//
// ⚠️ UN SEUL modèle pour les fichiers de PROJET et les fichiers de TÂCHE :
// `taskId = null` -> le fichier est rattaché au projet, sinon à la tâche.
// C'est le même patron que `Task.projectId` nullable (correctif 35), et le contraire
// de l'erreur du correctif 10, où l'on avait ouvert « un second chemin, plus pauvre,
// vers un besoin déjà couvert ». Deux tables auraient dupliqué la route, la purge, la
// redaction de périmètre et la logique d'upload.
//
// ⚠️ `projectId` reste renseigné MÊME pour un fichier de tâche. Ce n'est pas
// redondant : c'est ce qui permet de lister tous les fichiers d'un projet en une
// requête, et surtout d'appliquer le cloisonnement par site (`siteScope`) sans avoir à
// remonter la tâche pour retrouver son projet.
//
// ⚠️ AUCUNE purge par ancienneté, contrairement aux pièces jointes de chat (180 j) et
// aux médias calendar (30 j) : un devis ou un bon à tirer n'a pas à s'évaporer. La
// seule suppression est EXPLICITE, depuis l'interface. Conséquence assumée : ce dossier
// croît sans borne, il se surveille dans l'indicateur d'espace des Paramètres.
model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url        String
  // Le fichier sur disque porte un nom en uuid, JAMAIS celui fourni par le client
  // (règle absolue de routes/uploads.ts) : le nom d'origine doit donc vivre ici, comme
  // pour `ChatMessage.fileName`. `fileSize` évite une requête de plus pour afficher
  // « 2,4 Mo ».
  fileName   String
  fileSize   Int
  uploadedBy String // userId, référence libre vers User (pas de FK, style du schéma)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
}

model Campaign {
  id            String   @id @default(uuid())
  name          String
  site          String
  service       String[]
  type          String
  startDate     DateTime
  endDate       DateTime
  budgetPlanned Float
  status        String
  roi           Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SocialPost {
  id          String    @id @default(uuid())
  title       String
  status      String
  date        DateTime
  targets     String[]
  brands      String[]
  service     String
  networks    String[]
  concessions String[]
  mediaFiles  String[]
  // ⚠️ NOMS D'ORIGINE des médias, ajoutés au correctif 49 (09/09/2026), en TABLEAU
  // PARALLÈLE à `mediaFiles` : même longueur, même ordre, l'index fait le lien.
  //
  // Pourquoi pas dans le nom du fichier : `routes/uploads.ts` génère un uuid
  // VOLONTAIREMENT — « le nom d'origine ne doit JAMAIS entrer dans un chemin de fichier »
  // (traversée `../`) — et `routes/social.ts` impose cette forme uuid par expression
  // régulière. On stocke donc le nom À CÔTÉ, comme le font déjà `ProjectFile.fileName` et
  // `ChatMessage.fileName`.
  //
  // ⚠️ LE RISQUE DE CETTE FORME EST LA DÉRIVE entre les deux tableaux. La parade est
  // UNIQUE et vit dans le PUT de `routes/social.ts`, qui normalise systématiquement
  // `mediaNames` à la longueur de `mediaFiles`. Ne jamais écrire ces deux colonnes
  // ailleurs sans repasser par là.
  //
  // Un tableau vide est LÉGITIME : c'est l'état des publications antérieures au
  // correctif, et l'écran retombe alors sur le nom de fichier uuid.
  mediaNames  String[]  @default([])
  link        String
  wording     String
  lom         String
  /// ⚠️ HÉRITÉ depuis le 24/09/2026 : une seule classe. La source de vérité est `co2s`
  /// ci-dessous ; `co2` n'est plus que sa PREMIÈRE valeur, recalculée par la route à
  /// chaque écriture, gardée pour un retour arrière sans perte.
  co2         String
  /// Classes CO² — PLUSIEURS par publication (demande des Digital Managers, correctif 58).
  co2s        String[]  @default([])
  /// Marqueur PRO+ (B2B), comme `Project.proPlus`. Affichage seul : le Digital n'a pas de
  /// budget, ce marqueur ne change aucun montant.
  proPlus     Boolean   @default(false)
  archived    Boolean   @default(false)
  archivedAt  DateTime? // Renseigné à la bascule archived->true ; ancre la purge des médias (30j)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    SocialComment[]
}

/// Commentaires d'une publication du calendrier éditorial (correctif 50, 10/09/2026).
///
/// Demande de l'équipe digitale : pouvoir laisser une consigne sur un post sans passer
/// par le chat, où elle se perd. Le fil est porté par la publication, pas par une
/// conversation.
///
/// ⚠️ AUCUN NOM NI COULEUR D'AUTEUR N'EST STOCKÉ ICI, volontairement. `authorId` seul, et
/// l'identité se résout à l'affichage depuis la liste des utilisateurs — même règle que
/// les parties de jeu depuis le correctif 30, où recopier `player1Name` laissait un nom
/// périmé dans tout l'historique après un simple renommage.
///
/// `onDelete: Cascade` : supprimer une publication emporte ses commentaires (la ligne
/// n'existe plus, le fil n'a plus d'objet). C'est la même relation que
/// `ChatMessage → ChatConversation`.
///
/// ⚠️ L'index sur `postId` n'est PAS décoratif : Postgres n'indexe pas les clés
/// étrangères, et c'est exactement l'oubli qu'a coûté le correctif 48 sur `Task`.
model SocialComment {
  id        String     @id @default(uuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String     // référence libre vers User (pas de FK, style du schéma)
  content   String
  createdAt DateTime   @default(now())

  @@index([postId])
}

model DigitalTags {
  id       String   @id @default(uuid())
  networks String[]
  co2      String[]
  // ⚠️ Mentions Loi LOM, rendues éditables au correctif 49 (09/09/2026). Troisième et
  // DERNIÈRE catégorie ouverte à l'édition, et ce n'est pas arbitraire : `networks`,
  // `co2` et `lom` sont les seuls champs de `SocialPost` typés `String` LIBRE. Les
  // marques, services, statuts et sites sont adossés à des types de `types.ts`, indexent
  // des dictionnaires de couleurs et pilotent des tests métier — les rendre éditables en
  // base supprimerait la garantie de compilation sans rien mettre à la place, puisque
  // aucune validation de valeur n'existe côté serveur.
  // `@default([])` : les lignes existantes restent valides, la migration est additive.
  lom      String[] @default([])
}

model Contact {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  site            String
  service         String
  type            String
  rgpdConsent     Boolean
  tags            String[]
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Prévisionnel budgétaire : une ligne par site/bucket (ex. "Alpine-Clermont"),
// sans dimension année (aligné sur les données frontend réelles — décision validée).
model BudgetLine {
  id        String   @id @default(uuid())
  site      String   @unique
  brands    String[]
  entries   Json // { VN: number[12], VO: number[12], PR: number[12], APV: number[12] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dépense ponctuelle (page Expenses) — conservé tel quel : matche la forme vivante
// {date, service, site, comment, amount} réellement manipulée par la page (décision validée).
model OneOffExpense {
  id        String   @id @default(uuid())
  date      DateTime
  service   String
  site      String
  comment   String?
  amount    Float
  proPlus   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dépense fixe (module Dépenses Fixes) — calqué sur types.ts (FixedExpense) + alpineShare runtime.
model FixedExpense {
  id                 String   @id @default(uuid())
  date               DateTime
  service            String
  site               String
  sites              String[] @default([])
  budgetDistribution Json? // Record<string, number> — % par site
  comment            String
  amount             Float
  brand              String? // legacy — premier élément de brands
  brands             String[] @default([])
  alpineShare        Float? // % Alpine vs RDM (0-100) — null = 100 % Alpine
  nissanShare        Float? // % Nissan vs RDM (0-100) — null = 100 % Nissan
  proPlus            Boolean  @default(false)
  isAnnual           Boolean  @default(false) // fractionnée /12 à l'agrégation Budget (jamais dupliquée)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Module Matériel — calqué sur types.ts (Equipment / EquipmentBooking).
model Equipment {
  id            String             @id @default(uuid())
  name          String
  totalQuantity Int
  category      String?
  bookings      EquipmentBooking[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model EquipmentBooking {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  quantity    Int
  startDate   DateTime
  endDate     DateTime
  site        String
  service     String
  brand       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Module Chat — calqué sur types.ts (ChatConversation / ChatMessage).
/// Personnalisation du Chat, PAR UTILISATEUR ET PAR CONVERSATION (11/09/2026).
///
/// Demande de Theo apres un premier jet global : « je veux que la personnalisation soit
/// propre a chaque discussion ». `User.chatBackground` / `User.chatBubble` restent le
/// DEFAUT applique aux conversations qui n'ont pas de ligne ici (bouton « appliquer a
/// toutes mes discussions »), exactement comme le fond par defaut de WhatsApp.
///
/// ⚠️ Une ligne par (utilisateur, conversation) : la contrainte d'unicite est ce qui
/// permet l'upsert et empeche les doublons si deux onglets enregistrent en meme temps.
///
/// ⚠️ `userId` est une reference libre (style du schema) mais `conversationId` porte une
/// vraie FK en cascade : une conversation supprimee ne doit pas laisser des reglages
/// orphelins que plus rien ne peut atteindre.
model ChatCustomization {
  id             String           @id @default(uuid())
  userId         String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Memes formes que `User.chatBackground` : `proc:<id>` ou /uploads/chatbg/<uuid>.<ext>
  background     String?
  /// Identifiant d'une couleur de bulle du catalogue, jamais du CSS.
  bubble         String?
  updatedAt      DateTime         @updatedAt

  @@unique([userId, conversationId])
  @@index([userId])
}

model ChatConversation {
  id            String        @id @default(uuid())
  type          String // 'general' | 'private' | 'group'
  participants  String[] // userIds (références libres)
  adminIds      String[]      @default([])
  name          String?
  // Photo d'un groupe. Nom aligné sur `User.avatarUrl`, et comme lui on stocke
  // l'URL relative d'un fichier déposé par POST /api/uploads/avatar, JAMAIS du
  // base64 : la conversation est relue en entier à chaque GET /conversations, une
  // image encodée dedans la ferait grossir sans fin.
  // null = pas de photo, le client retombe sur les avatars empilés des membres.
  // Ne concerne que type='group' (garanti par le handler `chat:conversation:avatar`).
  avatarUrl     String?
  // THÈME PARTAGÉ de la conversation (24/09/2026) — vu par TOUS les membres, modifiable
  // par tout participant, jamais sur le Chat Général (« inviolable », décision de Théo).
  // Mêmes formes que l'ancienne personnalisation : `proc:<id>` ou /uploads/chatbg/<uuid>.<ext>
  // pour le fond, identifiant du catalogue `BULLES_CHAT` pour la bulle — validés par
  // `utils/personnalisationChat.ts`, seule porte. La bulle colore les messages de
  // CELUI QUI REGARDE (convention Messenger) : chacun voit ses propres bulles dans la
  // couleur du thème.
  background    String?
  bubble        String?
  // Accusés de lecture : Record<userId, ISO datetime> du dernier passage de chacun,
  // posé par `chat:conversation:read`. « Vu par » = membres dont la date dépasse
  // l'horodatage du dernier message.
  readAt        Json          @default("{}")
  /// ⚠️ OBSOLÈTE depuis le 24/09/2026 (thème partagé ci-dessus) : plus lue ni écrite.
  /// Table conservée pour permettre un retour arrière sans perte.
  customizations ChatCustomization[]
  pinnedBy      String[]      @default([])
  // Sourdine par utilisateur. ⚠️ Contrairement à `pinnedBy`, qui n'est JAMAIS
  // écrit en base (l'épinglage est un overlay localStorage côté client), ce
  // champ est bien la source de vérité : c'est le serveur qui décide d'envoyer
  // ou non la notification push, il doit donc la connaître.
  // La sourdine coupe le push, PAS le compteur non-lu (comportement Messenger).
  mutedBy       String[]      @default([])
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCounts  Json          @default("{}") // Record<userId, number>
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  senderColor    String
  content        String
  type           String // 'text' | 'image' | 'file'
  // --- Pièces jointes (05/08/2026) ---
  // Le fichier sur disque porte un nom en uuid (jamais celui fourni par le client) :
  // le nom d'origine doit donc être conservé ici pour l'affichage et le
  // téléchargement. `fileSize` évite une requête de plus juste pour afficher « 2,4 Mo ».
  fileName       String?
  fileSize       Int?
  // Renseigné par le job de purge quand le fichier a été supprimé du disque (180 j).
  // Le MESSAGE reste, l'interface affiche « pièce jointe expirée » — on ne réécrit
  // pas l'historique d'une conversation pour libérer de l'espace.
  fileExpiredAt  DateTime?
  timestamp      DateTime
  edited         Boolean          @default(false)
  editedAt       DateTime?
  deleted        Boolean          @default(false)
  reactions      Json             @default("{}") // Record<emoji, userId[]>
  replyToId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// Journal d'activité — calqué sur types.ts (ActivityLog). Immuable : pas d'updatedAt.
model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  userColor  String
  action     String
  entity     String
  entityName String
  entityId   String?
  timestamp  DateTime
  createdAt  DateTime @default(now())
}

// ============================================================================
// JEUX (05/08/2026)
//
// Jusqu'ici les défis ET les parties vivaient dans le `localStorage` du
// navigateur : défier un collègue était donc structurellement impossible (le
// défi n'existait que chez l'émetteur), et le « classement global » ne classait
// que les parties d'un seul poste. Ces deux modèles sont la couche qui manquait.
//
// ⚠️ On ne stocke QUE des `userId` — jamais le nom ni la couleur du joueur.
// L'ancienne version les recopiait dans chaque partie, si bien qu'un renommage
// laissait l'ancien nom au classement. L'identité se résout par id à l'affichage.
// ============================================================================

model GameChallenge {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  game       String // 'morpion' | 'connect4' | 'battleship'
  status     String // 'pending' | 'accepted' | 'refused'
  // La session créée à l'acceptation, pour que les deux joueurs y soient renvoyés.
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Un défi en attente est cherché par destinataire à chaque ouverture du lobby.
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model GameSession {
  id          String   @id @default(uuid())
  game        String // 'morpion' | 'connect4' | 'battleship'
  player1Id   String
  player2Id   String
  currentTurn String // userId
  // Plateau en Json : sa forme diffère par jeu et a vocation à évoluer (la
  // bataille navale est passée d'une grille de cellules à une liste de navires
  // identifiés) — le faire vivre ici évite une migration à chaque ajustement.
  //
  // ⚠️ CE CHAMP CONTIENT DES INFORMATIONS SECRÈTES (positions des navires) : il
  // ne doit JAMAIS sortir du backend tel quel. Seul `projectSessionFor()`
  // (utils/gameView.ts) produit une vue publiable, redactée pour un joueur donné.
  board       Json
  // 'placing' = bataille navale, flottes en cours de placement ; les autres jeux
  // démarrent directement en 'playing'.
  status      String // 'placing' | 'playing' | 'finished'
  // userId du vainqueur, ou 'draw' pour un match nul. Null tant que la partie court.
  winnerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Le lobby liste « mes parties » : deux index, un par place de joueur.
  @@index([player1Id, status])
  @@index([player2Id, status])
  // Le classement lit toutes les parties terminées.
  @@index([status])
}

// Réglages d'application modifiables EN LIGNE, sans redéploiement.
//
// Table générique clé/valeur, volontairement : le premier besoin est l'interrupteur
// de la rubrique Jeux (14/08/2026), mais le suivant ne demandera plus de migration.
//
// ⚠️ ABSENCE DE LIGNE = valeur par défaut, et la valeur par défaut est toujours la
// plus PRUDENTE (jeux éteints). Rien n'est semé à la migration : une table vide est
// donc un état valide et sûr, et non un état « pas encore initialisé ».
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String? // userId, pour savoir qui a basculé quoi
}

// ═══════════════════════════════════════════════════════════════════════════
// CONGÉS (12/09/2026) — rubrique portée depuis le fichier HTML du boss de Théo.
//
// ⚠️ TOUS LES COMPTES GEARBOX NE SONT PAS DU MARKETING : la rubrique a un PÉRIMÈTRE
// (`CongeMembre`), géré depuis l'écran par Master / Administrator / Director. Un compte
// hors périmètre ne voit même pas la rubrique.
// ═══════════════════════════════════════════════════════════════════════════

/// Un JOUR de congé posé — une ligne = une CELLULE du planning.
///
/// ⚠️ Forme choisie sur la maquette, où la saisie se fait cellule par cellule (clic sur
/// une case). Une ligne par PLAGE aurait obligé à découper/fusionner des intervalles à
/// chaque modification d'un seul jour. Le volume ne pose aucun problème : ~30 jours posés
/// par an et par personne, soit quelques centaines de lignes annuelles.
model CongeJour {
  id        String   @id @default(uuid())
  userId    String // référence libre vers User (pas de FK, style du schéma)
  /// 'YYYY-MM-DD'. String et NON DateTime, comme `User.birthdate` et `Task.deadline` :
  /// un jour de congé n'a ni heure ni fuseau, et un DateTime rouvrirait la classe de bug
  /// J+1 que ce projet combat déjà avec `parseLocalDate`.
  date      String
  /// FAMILLE de congé : 'CP' | 'RTT' | 'HR' | 'CSS' (sans solde) | 'CR' (révision).
  /// String libre en base, liste blanche côté route — le schéma n'a aucun enum.
  ///
  /// ⚠️ 12/09/2026 — la famille ne porte PLUS la demi-journée. Les codes 'CPAM'/'CPAPM'
  /// du correctif 54 mélangeaient les deux notions : ajouter « HR matin » et « congé sans
  /// solde » aurait demandé 'HRAM', 'HRAPM', 'CSSAM'… soit une combinatoire qui grossit à
  /// chaque type. Le moment était le bon : la table était VIDE en production.
  type      String
  /// Demi-journée : 'AM' (matin), 'PM' (après-midi), ou `null` pour un jour entier.
  /// Seule chose qui fait passer le comptage de 1 à 0,5 — voir `valeurJourConge()`.
  demi      String?
  /// Le ✓ de la maquette. ⚠️ Seuls Master et Director peuvent le poser (décision de
  /// Théo, Administrator en est exclu) — le contrôle est dans `routes/conges.ts`.
  validated Boolean  @default(false)
  createdBy String // qui a posé la ligne : soi-même, ou un gestionnaire pour un tiers
  updatedAt DateTime @updatedAt

  /// Une seule valeur par personne et par jour : c'est ce qui permet l'`upsert` et
  /// empêche deux onglets de créer deux lignes pour la même cellule.
  @@unique([userId, date])
  /// Le planning lit un mois à la fois, donc par intervalle de dates.
  @@index([date])
}

/// Périmètre de la rubrique : qui apparaît dans le planning.
///
/// ⚠️ Table dédiée plutôt qu'un booléen sur `User`, à dessein : `routes/users.ts`
/// déstructure ses champs explicitement à plusieurs endroits et `publicUser` doit suivre
/// — c'est le piège qui a coûté `nissanShare` puis `birthdate`. Une table séparée se gère
/// par sa propre route, ce qui colle à « géré par Master/Administrator/Director ».
///
/// ⚠️ Retirer quelqu'un d'ici ne supprime AUCUN de ses congés : il disparaît du planning,
/// ses lignes restent. Volontaire — on ne détruit pas un historique par un décochage.
model CongeMembre {
  id        String   @id @default(uuid())
  userId    String   @unique
  addedBy   String
  createdAt DateTime @default(now())
}

/// Droit à congés payés d'une personne pour UNE période de référence.
///
/// La période de référence légale court du 1er juin au 31 mai (art. L3141-3 : 2,5 jours
/// ouvrables par mois travaillé, 30 ouvrables au plus, soit 25 jours ouvrés). Elle est
/// identifiée par son année de DÉBUT : `2026` = 1er juin 2026 → 31 mai 2027.
///
/// ⚠️ Une ligne n'existe que si quelqu'un a modifié le droit par défaut. L'absence de
/// ligne vaut 25 jours (`CONGES_DROIT_DEFAUT`) — c'est ce qui évite d'avoir à créer
/// 16 lignes chaque 1er juin, et donc de dépendre d'une tâche planifiée qui n'existe pas.
///
/// ⚠️ Ne concerne QUE les CP. RTT, heures de récup, congé sans solde et congé révision
/// sont suivis mais ne décomptent aucun solde : ils relèvent d'autres compteurs (paie,
/// annualisation), qui ne sont pas dans Gearbox.
model CongeDroit {
  id        String   @id @default(uuid())
  userId    String
  /// Année de DÉBUT de la période de référence (2026 = juin 2026 → mai 2027).
  periode   Int
  /// Jours ouvrés acquis sur la période. Décimal : un temps partiel ou une arrivée en
  /// cours d'année donne des demi-journées (ex. 12,5).
  jours     Float
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([userId, periode])
}

/// POST-IT (01/10/2026) — agenda PERSONNEL de la To-do (sous-rubrique « Post-it »).
/// Connecté à RIEN d'autre dans Gearbox (ni Agenda, ni Dashboard, ni Export) : un post-it
/// n'est lu que par son auteur, et même le Master ne voit pas ceux des autres. Toutes les
/// requêtes de `routes/postits.ts` filtrent sur `userId = req.user.id`, jamais sur une
/// valeur envoyée par le client.
///
/// ⚠️ Dates en TEXTE LOCAL, comme `CongeJour.date` et `Task.deadline` : un créneau n'a pas
/// de fuseau, et un DateTime rouvrirait la classe de bug J+1. Format :
///  - créneau horaire : 'YYYY-MM-DDTHH:mm' (fin EXCLUSIVE) ;
///  - journée(s) entière(s) (`allDay`) : 'YYYY-MM-DD' (fin INCLUSIVE, le dernier jour couvert).
model PostIt {
  id        String   @id @default(uuid())
  userId    String // référence libre vers User (pas de FK, style du schéma)
  title     String
  start     String
  end       String
  allDay    Boolean  @default(false)
  /// Clé de la palette (`POSTIT_COLORS`, routes/postits.ts) — liste blanche côté route.
  color     String   @default("yellow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// GOOGLE FORMS (01/10/2026) — rubrique « Forms » de l'interface v2.
// Un SEUL compte Google (marketbony@gmail.com, partagé par l'équipe marketing) est connecté
// côté serveur ; les utilisateurs Gearbox passent par les routes /api/forms (FORMS_ROLES).
// ═══════════════════════════════════════════════════════════════════════════

/// Connexion au compte Google : UNE seule ligne (id = "google").
/// ⚠️ `refreshTokenEnc` est CHIFFRÉ (AES-256-GCM, clé `GOOGLE_TOKEN_KEY` hors base, google/client.ts) :
/// la base seule ne suffit pas à reconstituer l'accès. Jamais renvoyé au navigateur.
model GoogleConnection {
  id              String   @id @default("google")
  email           String?
  refreshTokenEnc String
  scopes          String
  connectedBy     String // userId Gearbox (Master)
  connectedAt     DateTime @default(now())
  lastError       String?
  updatedAt       DateTime @updatedAt
}

/// Catalogue des formulaires suivis dans Gearbox. L'API Google Forms ne sait PAS lister les
/// formulaires d'un compte (il faudrait l'accès Drive, écarté) : un formulaire y entre par
/// import de son lien d'édition (G1) ou par création depuis Gearbox (G2).
/// `structure` = dernier `forms.get` (questions), relu à chaque synchronisation.
model GoogleForm {
  id                 String    @id @default(uuid())
  formId             String    @unique // identifiant Google (lien /forms/d/<formId>/edit)
  title              String
  description        String?
  responderUri       String?
  isPublished        Boolean   @default(false)
  acceptingResponses Boolean   @default(false)
  revisionId         String?
  structure          Json?
  responseCount      Int       @default(0)
  lastResponseAt     DateTime?
  lastSyncedAt       DateTime?
  syncError          String?
  addedBy            String // userId Gearbox
  lastEditedBy       String? // userId Gearbox de la dernière modification faite DEPUIS Gearbox
  lastEditedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Cache des réponses (statistiques sans relire Google à chaque ouverture : le quota est
/// partagé par toute l'équipe, un seul utilisateur pour Google).
/// ⚠️ DONNÉES PERSONNELLES des répondants : purgées quand le formulaire est retiré de Gearbox,
/// lisibles par les seuls FORMS_ROLES. `id` = responseId Google.
model GoogleFormResponse {
  id              String   @id
  formId          String // GoogleForm.formId (identifiant Google)
  submittedAt     DateTime // lastSubmittedTime
  respondentEmail String?
  answers         Json
  createdAt       DateTime @default(now())

  @@index([formId, submittedAt])
}

/// Journal des modifications faites DEPUIS Gearbox (G2, 01/10/2026). Côté Google, tout apparaît fait par le
/// compte partagé : c'est ici qu'on sait QUI a modifié quoi. Les changements faits directement dans Google
/// (thème, couleurs…) n'y figurent pas.
model GoogleFormLog {
  id      String   @id @default(uuid())
  formId  String // GoogleForm.formId (identifiant Google)
  userId  String
  action  String // 'create' | 'edit' | 'publish' | 'duplicate' | 'import' | 'remove'
  detail  String?
  at      DateTime @default(now())

  @@index([formId, at])
}

// ═══════════════════════════════════════════════════════════════════════════
// FORMS BONY (01/10/2026) — formulaires MAISON : édités dans Gearbox, servis au public par le
// Worker Cloudflare `forms` (forms.bonyauto-mobile.workers.dev/<publicId>). Format de définition :
// shared/bonyform.ts (copie : backend/src/bonyforms/schema.ts).
// ═══════════════════════════════════════════════════════════════════════════

/// Un formulaire Bony. `draft` = définition en cours d'édition ; `published` = celle que sert le
/// Worker (copie figée à chaque publication) : on retouche un formulaire en ligne sans casser celui
/// qui tourne. `publicId` = segment d'adresse public, aléatoire (impossible à deviner).
model BonyForm {
  id             String    @id @default(uuid())
  publicId       String    @unique
  title          String
  /// 'draft' (jamais publié) | 'published' (en ligne) | 'closed' (dépublié : le Worker affiche « fermé »)
  status         String    @default("draft")
  draft          Json
  published      Json?
  version        Int       @default(0)
  publishedAt    DateTime?
  /// Dernière erreur d'envoi de la définition au Worker (null = Worker à jour).
  syncError      String?
  responseCount  Int       @default(0)
  lastResponseAt DateTime?
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Réponse reçue du Worker. `id` est fixé PAR LE WORKER (uuid) : un renvoi depuis sa file d'attente
/// (Gearbox indisponible au moment de l'envoi) ne crée jamais de doublon.
/// ⚠️ DONNÉES PERSONNELLES des répondants (consentement recueilli par le formulaire).
/// `uniqueKey` = « champ:valeur » du champ marqué unique (une participation par e-mail) ; l'index
/// unique sur (formId, uniqueKey) fait le refus, sans course possible.
model BonyFormResponse {
  id          String   @id
  formId      String // BonyForm.id
  version     Int
  answers     Json
  meta        Json?
  uniqueKey   String?
  submittedAt DateTime
  receivedAt  DateTime @default(now())

  @@unique([formId, uniqueKey])
  @@index([formId, submittedAt])
}

/// Kit de marque des Forms Bony (F2a, 01/10/2026) : un thème complet enregistré sous un nom
/// (« Salon Renault 2026 »), PARTAGÉ par toute l'équipe (décision de Théo), réappliqué en un clic.
model BonyThemeKit {
  id        String   @id @default(uuid())
  name      String
  theme     Json
  createdBy String
  createdAt DateTime @default(now())
}

/// Police de MARQUE importée par l'équipe (fichier chez Cloudflare, KV du Worker). Partagée par tous.
model BonyFont {
  id        String   @id @default(uuid())
  family    String
  weight    Int      @default(400)
  style     String   @default("normal")
  url       String
  fileName  String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([family, weight, style])
}
