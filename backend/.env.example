# Environnement de dev du backend. Copier en backend/.env et remplir — JAMAIS committé.

# Connexion applicative : pooler transaction Supabase (port 6543, ?pgbouncer=true requis par Prisma).
#
# /!\ PARAMETRES DE POOL EXPLICITES, ajoutes au correctif 48 (07/09/2026). A reporter
#     A LA MAIN dans les DEUX .env reels : celui de ce poste et ~/gearbox/.env sur le
#     VPS. Oublies sur le VPS, le backend repart sur les defauts de Prisma et le gain
#     mesurable disparait -- sans aucun symptome visible.
#
# /!\ SI LA VALEUR EST ENTRE GUILLEMETS dans le .env reel, les parametres vont A
#     L'INTERIEUR des guillemets. Erreur commise le 07/09/2026 : ajoutes apres le
#     guillemet fermant, dotenv ne lisait plus que l'URL d'origine cote gauche et Prisma
#     rendait << the URL must start with the protocol postgresql:// >> sur CHAQUE requete
#     -- l'API demarrait normalement et toutes les routes tombaient. Verifier apres
#     modification : le backend doit journaliser << Jeux ALLUMES >> (ou ETEINTS), ce qui
#     prouve une lecture reussie en base ; << lecture impossible >> signale l'inverse.
#
#   connection_limit=10  Prisma prend par defaut `vCPU x 2 + 1`, soit 17 sur les 8 vCPU
#                        du VPS. Le pooler transaction Supabase a un default_pool_size
#                        qui se compte en dizaines : 10 laisse de la marge pour psql
#                        depuis le hotspot et pour les scripts de sauvegarde. La valeur
#                        n'a de sens que parce que le backend n'a plus qu'UN client
#                        Prisma (backend/src/db.ts) -- avec les 27 d'avant, 10 par client
#                        aurait fait 270.
#   pool_timeout=20      Attente maximale d'une connexion du pool avant P2024. Defaut 10.
#                        Pour une sauvegarde declenchee par un humain, attendre vaut
#                        mieux qu'echouer.
#   connect_timeout=10   Defaut 5, un peu juste sur un lien a ~22 ms qui hoquette.
#
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=10
# Migrations Prisma (migrate dev/deploy) : pooler session Supabase (port 5432, sans ?pgbouncer=true).
# L'hôte direct db.*.supabase.co est IPv6-only, inaccessible depuis un réseau IPv4.
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Secret de signature des JWT (générer : openssl rand -hex 32).
JWT_SECRET=change-me

# 3001 en dev : vite occupe le 3000 (proxy /api configuré dans vite.config.ts).
PORT=3001
NODE_ENV=development

# Journal des requetes Prisma. A 1, chaque requete SQL est tracee : c'est ce qui permet
# de COMPTER les aller-retours d'un PUT de projet (~30 avant le correctif 48, 4 apres).
# Laisser vide en production -- bruyant, et les valeurs finiraient dans les logs.
PRISMA_LOG_QUERIES=

# Assistant IA mIAouss (08/10/2026) : Qwen3.8 27B chez Groq, puis Cloudflare Workers AI en secours. Offres gratuites.
# Absentes : la rubrique repond 503 (pas configure).
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
